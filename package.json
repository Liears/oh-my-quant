{
  "name": "whyj-quant",
  "version": "1.2.0",
  "type": "module",
  "description": "WhyJ Quant — Interactive AI-powered quantitative analysis terminal",
  "keywords": [
    "quantitative",
    "finance",
    "stock",
    "backtest",
    "factor",
    "risk",
    "cli",
    "terminal",
    "ai",
    "agent"
  ],
  "homepage": "https://oh-my-quant.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjingo/oh-my-quant.git"
  },
  "license": "MIT",
  "author": "yangjing",
  "main": "dist/index.js",
  "bin": {
    "whyj": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "typecheck": "bun run tsc --noEmit",
    "gen:insights": "bun run scripts/generate-insights.ts",
    "test": "bun run test:fence && bun test",
    "test:fence": "bun run scripts/check-test-fence.ts",
    "test:manual-artifacts": "bun test --path-ignore-patterns 'reference/**' src/artifact/test/gen-kline.test.ts src/artifact/test/gen-kc50.test.ts src/artifact/test/gen-fund.test.ts src/artifact/test/gen-fund-006265.test.ts src/artifact/test/gen-sst-all.test.ts src/artifact/test/gen-stock-300308.test.ts",
    "test:providers": "bun run scripts/provider-smoke.ts",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run gen:insights && bun run build && bun run typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.78.0",
    "typebox": "^1.1.39"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
