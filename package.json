{
  "name": "whyj-quant",
  "version": "1.3.1",
  "type": "module",
  "description": "WhyJ Quant — Interactive AI-powered quantitative analysis terminal",
  "keywords": [
    "quantitative",
    "finance",
    "stock",
    "backtest",
    "factor",
    "risk",
    "cli",
    "terminal",
    "ai",
    "agent"
  ],
  "homepage": "https://github.com/yangjingo/oh-my-quant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjingo/oh-my-quant.git"
  },
  "license": "MIT",
  "author": "yangjing",
  "main": "dist/index.js",
  "bin": {
    "whyj": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "typecheck": "bun run tsc --noEmit",
    "gen:insights": "bun run scripts/generate-insights.ts",
    "test": "bun run test:fence && bun test",
    "test:fence": "bun run scripts/check-test-fence.ts",
    "test:manual-artifacts": "bun test --path-ignore-patterns 'reference/**' src/artifact/test/gen-kline.test.ts src/artifact/test/gen-kc50.test.ts src/artifact/test/gen-fund.test.ts src/artifact/test/gen-fund-006265.test.ts src/artifact/test/gen-sst-all.test.ts src/artifact/test/gen-stock-300308.test.ts",
    "test:providers": "bun run scripts/provider-smoke.ts",
    "bench:model": "bun run scripts/measure-model.ts",
    "eval:research": "bun run scripts/evaluate-research.ts",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run gen:insights && bun run build && bun run typecheck",
    "desktop:build": "bun run --cwd desktop build",
    "desktop:dist": "bun run desktop:build && bun run --cwd desktop dist:win"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@mozilla/readability": "0.6.0",
    "ignore": "7.0.12",
    "linkedom": "0.18.13",
    "proper-lockfile": "4.1.2",
    "strip-json-comments": "5.0.3",
    "typebox": "1.3.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.0"
  }
}
